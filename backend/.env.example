# ============================================================
#  sync. 백엔드 환경 변수 (.env)
# ============================================================
#  사용법: 이 파일을 같은 위치에 .env 로 복사한 뒤 값을 채우세요.
#    cp .env.example .env
# ============================================================

# ── Azure Speech Service ────────────────────────────────────
# 발급: https://portal.azure.com → Speech Services → 키 및 엔드포인트
# 음성 인식(STT) + 음성 합성(TTS)에 사용됩니다.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=koreacentral

# ── Google Gemini API ───────────────────────────────────────
# 발급: https://aistudio.google.com/apikey
# 면접 질문 생성, 꼬리 질문, 페르소나 분석 등에 사용됩니다.
GEMINI_API_KEY=

# Gemini 모델 (기본값 사용 시 아래 줄은 주석 그대로 두세요)
# GEMINI_MODEL=models/gemini-3.1-flash-lite

# ── Pollinations (이미지 생성) ──────────────────────────────
# 발급: https://pollinations.ai
# 면접 종료 시 동물 페르소나 프로필 이미지 생성에 사용됩니다.
# 키 없이도 작동하지만, 요청 제한이 있을 수 있습니다.
POLLINATIONS_API_KEY=

# ── PostgreSQL ──────────────────────────────────────────────
# docker-compose.yml 기본값과 일치합니다.
# Docker 설정을 변경하지 않았다면 그대로 사용하세요.
DATABASE_URL=postgresql://sync:sync123@localhost:5432/speaking

# ── JWT 인증 ────────────────────────────────────────────────
# 반드시 본인만의 랜덤 값으로 교체하세요!
# 생성: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# ── OpenAI (선택) ───────────────────────────────────────────
# Whisper API 등 OpenAI 서비스가 필요한 경우에만 설정하세요.
# 로컬 Whisper를 사용하는 경우 비워둬도 됩니다.
# OPENAI_API_KEY=
